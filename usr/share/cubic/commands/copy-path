# Copy a file or directory for Cubic.

########################################################################
# Arguments
########################################################################

program=${0}
number_arguments=${#}
source_path=${1}
target_path=${2}
user=${3}

# echo "program..................... $program"
# echo "number of arguments......... $number_arguments"
# echo "source path................. ${source_path}."
# echo "target path................. ${target_path}."
# echo "user........................ ${user}."

########################################################################
# Command
########################################################################

# If a user was supplied, change ownership.
if [[ ${user} ]]; then
    rsync --archive --inplace --info=progress2 --chown=${user}:${user} --owner --group "${source_path}" "${target_path}"
else
    rsync --archive --inplace --info=progress2 "${source_path}" "${target_path}"
fi

