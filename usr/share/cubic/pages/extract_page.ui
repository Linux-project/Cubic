<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkGrid" id="extract_page">
    <property name="width_request">950</property>
    <property name="height_request">650</property>
    <property name="can_focus">False</property>
    <property name="border_width">0</property>
    <property name="row_spacing">18</property>
    <child>
      <object class="GtkLabel" id="extract_page__instructions_label">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="margin_left">18</property>
        <property name="margin_right">18</property>
        <property name="margin_top">18</property>
        <property name="label" translatable="yes">Copying files from the original disk image, and extracting the compressed Linux file system.</property>
        <property name="justify">fill</property>
        <property name="wrap">True</property>
        <property name="max_width_chars">0</property>
        <property name="xalign">0</property>
        <property name="yalign">0.5</property>
        <attributes>
          <attribute name="scale" value="1.25"/>
        </attributes>
      </object>
      <packing>
        <property name="left_attach">0</property>
        <property name="top_attach">0</property>
      </packing>
    </child>
    <child>
      <object class="GtkGrid">
        <property name="width_request">712</property>
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="halign">center</property>
        <property name="valign">center</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="border_width">18</property>
        <property name="row_spacing">18</property>
        <property name="column_homogeneous">True</property>
        <child>
          <object class="GtkGrid" id="extract_page__casper_directory_section">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="row_spacing">6</property>
            <property name="column_spacing">12</property>
            <child>
              <object class="GtkImage" id="extract_page__casper_directory_status">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="valign">start</property>
                <property name="icon_name">cubic-bullet-symbolic</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkSpinner" id="extract_page__casper_directory_spinner">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="valign">start</property>
                <property name="active">True</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="extract_page__casper_directory_title">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="label" translatable="yes">Locate the compressed Linux file system.</property>
                <property name="wrap">True</property>
                <property name="max_width_chars">0</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="extract_page__casper_directory_message">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="opacity">0.50196078431372548</property>
                <property name="hexpand">True</property>
                <property name="wrap">True</property>
                <property name="max_width_chars">0</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <placeholder/>
            </child>
          </object>
          <packing>
            <property name="left_attach">0</property>
            <property name="top_attach">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkGrid" id="extract_page__unsquashfs_section">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="row_spacing">6</property>
            <property name="column_spacing">12</property>
            <child>
              <object class="GtkImage" id="extract_page__unsquashfs_status">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="valign">start</property>
                <property name="icon_name">cubic-bullet-symbolic</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkSpinner" id="extract_page__unsquashfs_spinner">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="valign">start</property>
                <property name="active">True</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="extract_page__unsquashfs_title">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="label" translatable="yes">Extract the compressed Linux file system.</property>
                <property name="wrap">True</property>
                <property name="max_width_chars">0</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkProgressBar" id="extract_page__unsquashfs_progressbar">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="show_text">True</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="extract_page__unsquashfs_message">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="opacity">0.50196078431372548</property>
                <property name="hexpand">True</property>
                <property name="wrap">True</property>
                <property name="max_width_chars">0</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">2</property>
              </packing>
            </child>
            <child>
              <placeholder/>
            </child>
            <child>
              <placeholder/>
            </child>
          </object>
          <packing>
            <property name="left_attach">0</property>
            <property name="top_attach">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkGrid" id="extract_page__copy_original_iso_files_section">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="row_spacing">6</property>
            <property name="column_spacing">12</property>
            <child>
              <object class="GtkImage" id="extract_page__copy_original_iso_files_status">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="valign">start</property>
                <property name="icon_name">cubic-bullet-symbolic</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkSpinner" id="extract_page__copy_original_iso_files_spinner">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="valign">start</property>
                <property name="active">True</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="extract_page__copy_original_iso_files_title">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="label" translatable="yes">Copy important files from the original disk image.</property>
                <property name="wrap">True</property>
                <property name="max_width_chars">0</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkProgressBar" id="extract_page__copy_original_iso_files_progressbar">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="hexpand">True</property>
                <property name="show_text">True</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="extract_page__copy_original_iso_files_message">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="opacity">0.50196078431372548</property>
                <property name="hexpand">True</property>
                <property name="wrap">True</property>
                <property name="max_width_chars">0</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">2</property>
              </packing>
            </child>
            <child>
              <placeholder/>
            </child>
            <child>
              <placeholder/>
            </child>
          </object>
          <packing>
            <property name="left_attach">0</property>
            <property name="top_attach">2</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="left_attach">0</property>
        <property name="top_attach">1</property>
      </packing>
    </child>
  </object>
  <object class="GtkSizeGroup" id="extract_page__size_group">
    <property name="mode">both</property>
    <widgets>
      <widget name="extract_page__copy_original_iso_files_status"/>
      <widget name="extract_page__copy_original_iso_files_spinner"/>
      <widget name="extract_page__casper_directory_status"/>
      <widget name="extract_page__casper_directory_spinner"/>
      <widget name="extract_page__unsquashfs_status"/>
      <widget name="extract_page__unsquashfs_spinner"/>
    </widgets>
  </object>
</interface>
